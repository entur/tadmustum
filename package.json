{
  "name": "tadmustum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "run-p --race copy:theme copy:config",
    "predev:full": "run-p --race copy:theme copy:config-full-local",
    "dev": "vite",
    "dev:full": "vite",
    "build": "tsc -b && vite build",
    "copy:theme": "ncp .github/environments/theme-dev.json public/theme-dev.json",
    "copy:config": "ncp .github/environments/config-local.json public/config.json",
    "copy:config-full-local": "ncp .github/environments/config-local-full.json public/config.json",
    "test": "cross-env TZ=UTC vitest",
    "test:run": "cross-env TZ=UTC vitest run",
    "lint": "eslint .",
    "check": "prettier . --check",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^7.0.7",
    "@mapbox/mapbox-gl-draw": "^1.4.3",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.18.0",
    "@mui/x-date-pickers": "^9.18.0",
    "dayjs": "^1.11.13",
    "graphql": "^16.11.0",
    "i18next": "^25.2.1",
    "maplibre-gl": "^6.12.0",
    "npm-run-all": "^4.1.5",
    "oidc-client-ts": "^3.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^15.5.2",
    "react-map-gl": "^8.1.3",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^7.18.5",
    "uuid": "^11.1.1",
    "yup": "^1.7.1"
  },
  "overrides": {
    "rollup": "4.63.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mapbox__mapbox-gl-draw": "^1.4.3",
    "@types/node": "^22.15.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.0.0",
    "ncp": "^2.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
